# Django
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# Database (Postgres). Set USE_SQLITE=1 to use the local db.sqlite3 instead.
NEON_DATABASE_URL=postgresql://user:password@host/dbname
# USE_SQLITE=1

# Google Books
GOOGLE_API_KEY=your-google-books-api-key

# Cloudinary (profile pictures)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email (password reset)
EMAIL_ADDRESS=your-gmail-address
EMAIL_PASSWORD=your-gmail-app-password

# Frontend
# Base URL used to build the password reset link sent by email
FRONTEND_URL=http://localhost:3000
# Space-separated browser origins allowed to call the API.
# Left blank with DEBUG=True, all origins are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000
